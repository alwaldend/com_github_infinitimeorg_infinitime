load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("@bazel_skylib//rules:write_file.bzl", "write_file")

write_file(
    name = "patches",
    out = "patches.sh",
    content = [
        "#!/usr/bin/env sh",
        "set -eux",
        'cd "${BUILD_WORKSPACE_DIRECTORY}"',
        "git diff --check 1.15.0",
        "git diff \
            1.15.0 \
            >../src/projects/infinitime/main/patch/patch.patch \
        ",
    ],
    is_executable = True,
)

compile_pip_requirements(
    name = "requirements",
    srcs = [":requirements.in"],
    requirements_txt = ":requirements.txt",
)

alias(
    name = "gcc_srcs",
    actual = "@com_alwaldend_com_github_infinitimeorg_infinitime_com_arm_developer_gcc_arm//:srcs",
    visibility = ["//:__pkg__"],
)

alias(
    name = "gcc_marker",
    actual = "@com_alwaldend_com_github_infinitimeorg_infinitime_com_arm_developer_gcc_arm//:marker",
    visibility = ["//:__pkg__"],
)

alias(
    name = "nrfsdk_srcs",
    actual = "@com_alwaldend_com_github_infinitimeorg_infinitime_com_nordicsemi_developer_nrfsdk//:srcs",
    visibility = ["//:__pkg__"],
)

alias(
    name = "nrfsdk_marker",
    actual = "@com_alwaldend_com_github_infinitimeorg_infinitime_com_nordicsemi_developer_nrfsdk//:marker",
    visibility = ["//:__pkg__"],
)

pkg_filegroup(
    name = "nrfsdk",
    srcs = [":nrfsdk_srcs"],
    prefix = "nrfsdk",
    visibility = ["//:__pkg__"],
)

pkg_filegroup(
    name = "gcc",
    srcs = [":gcc_srcs"],
    prefix = "gcc",
    visibility = ["//:__pkg__"],
)

py_console_script_binary(
    name = "adafruit-nrfutil",
    pkg = "@com_alwaldend_com_github_infinitimeorg_infinitime_pip//adafruit_nrfutil",
    visibility = ["//:__pkg__"],
)

alias(
    name = "pnpm",
    actual = "@com_alwaldend_com_github_infinitimeorg_infinitime_pnpm//:pnpm",
    visibility = ["//:__pkg__"],
)
