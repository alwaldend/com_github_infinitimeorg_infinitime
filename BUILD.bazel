load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@bazelrc-preset.bzl", "bazelrc_preset")
load("@com_alwaldend_com_github_infinitimeorg_infinitime_npm//:defs.bzl", "npm_link_all_packages")
load("@com_alwaldend_com_github_infinitimeorg_infinitime_npm//:lv_font_conv/package_json.bzl", lv_font_conv = "bin")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("//tools/build/bzl:build_binary.bzl", "build_binary")

write_file(
    name = "write_patches",
    out = "write_patches.sh",
    content = [
        "#!/usr/bin/env sh",
        "set -eu",
        'cd "${BUILD_WORKSPACE_DIRECTORY}"',
        "git format-patch --output-directory ../src/projects/infinitime/main/patch 1.15.0",
    ],
    is_executable = True,
)

run_binary(
    name = "build",
    outs = ["build.dir"],
    args = [
        "--build_dir",
        "$(execpath build.dir)",
    ],
    tool = ":build_binary",
    visibility = ["//visibility:public"],
)

build_binary(
    name = "build_binary",
    srcs = [
        ":gcc",
        ":nrfsdk",
        ":srcs",
    ],
    tools = [
        ":adafruit_nrfutil",
        ":lv_font_conv",
    ],
)

cmake(
    name = "cmake",
    build_data = [
        ":adafruit_nrfutil",
        ":gcc_marker",
        ":gcc_srcs",
        ":lv_font_conv",
        ":nrfsdk_marker",
        ":nrfsdk_srcs",
    ],
    cache_entries = {
        "CMAKE_BUILD_TYPE": "Release",
        "ARM_NONE_EABI_TOOLCHAIN_PATH": "$(execpath :gcc_marker)",
        "NRF5_SDK_PATH": "$(execpath :nrfsdk_marker)",
        "BUILD_DFU": "1",
        "BUILD_RESOURCES": "1",
    },
    env = {
        "PATH": "$(execpath :adafruit_nrfutil)/../:$(execpath :lv_font_conv)/../",
    },
    exec_compatible_with = ["@platforms//os:linux"],
    generate_args = [
        "-G",
        "Unix Makefiles",
    ],
    lib_source = ":srcs_files",
    out_bin_dir = "build",
    tags = ["no-sandbox"],  # needs linux utils
    targets = ["pinetime-mcuboot-app"],
)

pkg_filegroup(
    name = "srcs",
    srcs = [
        ":srcs_files",
        "//tools/mcuboot:srcs",
    ],
    prefix = "srcs",
)

pkg_files(
    name = "srcs_files",
    srcs = glob(["**"]),
    strip_prefix = strip_prefix.from_pkg(),
)

alias(
    name = "gcc_srcs",
    actual = "@com_alwaldend_com_github_infinitimeorg_infinitime_com_arm_developer_gcc_arm//:srcs",
)

alias(
    name = "gcc_marker",
    actual = "@com_alwaldend_com_github_infinitimeorg_infinitime_com_arm_developer_gcc_arm//:marker",
)

alias(
    name = "nrfsdk_srcs",
    actual = "@com_alwaldend_com_github_infinitimeorg_infinitime_com_nordicsemi_developer_nrfsdk//:srcs",
)

alias(
    name = "nrfsdk_marker",
    actual = "@com_alwaldend_com_github_infinitimeorg_infinitime_com_nordicsemi_developer_nrfsdk//:marker",
)

pkg_filegroup(
    name = "nrfsdk",
    srcs = [":nrfsdk_srcs"],
    prefix = "nrfsdk",
)

pkg_filegroup(
    name = "gcc",
    srcs = [":gcc_srcs"],
    prefix = "gcc",
)

py_console_script_binary(
    name = "adafruit_nrfutil",
    pkg = "@com_alwaldend_com_github_infinitimeorg_infinitime_pip//adafruit_nrfutil",
    script = "adafruit-nrfutil",
)

alias(
    name = "pnpm",
    actual = "@com_alwaldend_com_github_infinitimeorg_infinitime_pnpm//:pnpm",
)

npm_link_all_packages(
    name = "node_modules",
)

lv_font_conv.lv_font_conv_binary(
    name = "lv_font_conv",
)

compile_pip_requirements(
    name = "requirements",
    srcs = [":requirements.in"],
    requirements_txt = ":requirements.txt",
)

bazelrc_preset(
    name = "preset",
    strict = True,
)

exports_files(
    ["LICENSE"],
    visibility = ["//:__subpackages__"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0",
    ],
    license_text = "//:LICENSE",
    visibility = ["//:__subpackages__"],
)
