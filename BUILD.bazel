load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("@com_alwaldend_com_github_infinitimeorg_infinitime_npm//:defs.bzl", "npm_link_all_packages")
load("@com_alwaldend_com_github_infinitimeorg_infinitime_npm//:lv_font_conv/package_json.bzl", lv_font_conv = "bin")
load("//bazel/bzl:build_binary.bzl", "build_binary")
load("//bazel/bzl:build_run_binary.bzl", "build_run_binary")

write_source_files(
    name = "write",
    files = {
        "compile_commands.json": "//:compile_commands",
    },
)

genrule(
    name = "compile_commands",
    srcs = [":build"],
    outs = ["build_compile_commands.json"],
    cmd = """
        cp $(execpath :build)/compile_commands.json \
            $(execpath build_compile_commands.json)
    """,
    visibility = ["//visibility:public"],
)

genrule(
    name = "dfu",
    srcs = [":build"],
    outs = ["pinetime-mcuboot-app-dfu-1.15.0.zip"],
    cmd = """
        cp $(execpath :build)/src/pinetime-mcuboot-app-dfu-1.15.0.zip \
            $(execpath pinetime-mcuboot-app-dfu-1.15.0.zip)
    """,
    visibility = ["//visibility:public"],
)

build_run_binary(
    name = "build",
    binary = ":build_binary",
)

build_binary(
    name = "build_binary",
    srcs = [
        "//bazel:gcc",
        "//bazel:nrfsdk",
        ":srcs",
    ],
    build_type = "Release",
    tools = [
        "//bazel:adafruit-nrfutil",
        ":lv_font_conv",
    ],
)

pkg_filegroup(
    name = "srcs",
    srcs = [
        ":srcs_files",
        "//tools/mcuboot:srcs",
    ],
    prefix = "srcs",
)

pkg_files(
    name = "srcs_files",
    srcs = glob(["**"]),
    strip_prefix = strip_prefix.from_pkg(),
)

npm_link_all_packages(
    name = "node_modules",
)

lv_font_conv.lv_font_conv_binary(
    name = "lv_font_conv",
)

exports_files(
    ["LICENSE"],
    visibility = ["//visibility:public"],
)
